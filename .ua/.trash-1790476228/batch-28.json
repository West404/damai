      "type": "service",
      "name": "mysql",
      "filePath": "docker-compose.yml",
      "summary": "MySQL 8.0 container (damai-mysql) persisting data in a named volume and auto-initializing schemas from ./sql/cloud on first startup.",
      "tags": ["infrastructure", "database", "containerization"],
      "complexity": "simple"
    },
