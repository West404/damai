  "nodes": [
    {
      "id": "document:README.md",
      "type": "document",
      "name": "README.md",
      "filePath": "README.md",
      "summary": "Main project documentation for the damai high-concurrency ticketing system, covering background, architecture, tech stack (Spring Cloud Alibaba, Redis, Kafka, ELK, Sentinel), business flow, feature highlights, and startup instructions across 28 sections.",
      "tags": ["documentation", "entry-point", "overview", "microservices"],
      "complexity": "moderate"
    },
    {
      "id": "service:docker-compose.yml",
      "type": "service",
      "name": "docker-compose.yml",
      "filePath": "docker-compose.yml",
      "summary": "One-click Docker Compose orchestration for the full damai stack: middleware (MySQL, Redis, Nacos, Kafka, Elasticsearch) plus eight business microservices built from a shared Dockerfile, with healthcheck-gated startup ordering.",
      "tags": ["orchestration", "infrastructure", "deployment", "containerization"],
      "complexity": "complex",
      "languageNotes": "Uses YAML anchors (x-app-common, x-app-env) to share restart/network/depends_on and Nacos/Redis environment settings across all business services."
    },
    {
      "id": "config:pom.xml",
      "type": "config",
      "name": "pom.xml",
      "filePath": "pom.xml",
      "summary": "Root Maven POM (packaging pom) aggregating 10 modules and centrally managing dependency versions for Spring Boot 3.3.0, Spring Cloud 2023.0.2, Spring Cloud Alibaba, MyBatis-Plus, Redisson, ShardingSphere and others, with compiler/flatten/source plugins.",
      "tags": ["configuration", "build-system", "maven", "dependency-management"],
      "complexity": "moderate",
      "languageNotes": "Uses ${revision} CI-friendly versioning with flatten-maven-plugin to resolve the placeholder at install/deploy time."
    },
    {
