      "filePath": "damai-redisson-framework/damai-service-delay-queue-framework/src/main/java/com/damai/core/IsolationRegionSelector.java",
      "lineRange": [10, 34],
      "summary": "分片下标选择器类，维护当前计数并在达到阈值时归零，对外提供 getIndex 实现循环递增的分片路由。",
      "tags": ["分片", "并发", "轮询", "selector"],
      "complexity": "simple"
    },
    {
      "id": "function:damai-redisson-framework/damai-service-delay-queue-framework/src/main/java/com/damai/core/IsolationRegionSelector.java:getIndex",
