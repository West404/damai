    {
      "id": "file:damai-server/damai-admin-service/src/main/java/com/damai/config/MonitorServerConfig.java",
      "type": "file",
      "name": "MonitorServerConfig.java",
      "filePath": "damai-server/damai-admin-service/src/main/java/com/damai/config/MonitorServerConfig.java",
      "summary": "Spring Boot Admin 服务监控的自动装配配置类，从配置项 dingtalk.token 读取钉钉机器人地址，并向容器注册 DingTalkMessage 与 MonitorServer 两个 Bean。",
      "tags": ["configuration", "spring-boot", "monitoring", "入口点"],
      "complexity": "simple",
      "languageNotes": "使用 @Value 的 ${dingtalk.token:} 默认值语法，token 未配置时注入空串，从而在运行期静默跳过告警发送。"
    },
    {
      "id": "file:damai-server/damai-admin-service/src/main/java/com/damai/monitor/DingTalkMessage.java",
      "type": "file",
      "name": "DingTalkMessage.java",
      "filePath": "damai-server/damai-admin-service/src/main/java/com/damai/monitor/DingTalkMessage.java",
      "summary": "钉钉机器人消息发送客户端，把文本内容封装成钉钉 text 类型 JSON 请求体并通过 RestTemplate POST 到 webhook 地址。",
      "tags": ["utility", "notify", "http-client", "serialization", "监控告警"],
      "complexity": "simple",
      "languageNotes": "使用 Lombok @RequiredArgsConstructor 注入 final token 字段，restTemplate 为类内直接实例化，未交由 Spring 管理。"
    },
    {
      "id": "file:damai-server/damai-admin-service/src/main/java/com/damai/monitor/MonitorServer.java",
      "type": "file",
      "name": "MonitorServer.java",
      "filePath": "damai-server/damai-admin-service/src/main/java/com/damai/monitor/MonitorServer.java",
      "summary": "继承 Spring Boot Admin 的 AbstractStatusChangeNotifier，监听实例状态变更事件，按白名单过滤噪音变更后通过 SpEL 模板渲染告警文案并调用钉钉发送。",
      "tags": ["monitoring", "event-handler", "notify", "继承扩展", "reactor"],
      "complexity": "moderate",
      "languageNotes": "告警模板使用 SpEL 的 ParserContext.TEMPLATE_EXPRESSION（#{...} 占位符）配合 MapAccessor 渲染；通知在 Mono.fromRunnable 中延迟执行，返回响应式流。"
    },
