      "name": "d_depth_rule",
      "filePath": "sql/cloud/damai_customize.sql",
      "summary": "深度规则表，通过限制开始/结束时间窗口、统计时间与统计时间类型（秒/分钟）、调用阈值与生效时长描述深度限流规则。",
      "tags": ["database", "规则配置", "限流", "定制服务"],
      "complexity": "simple"
    },
    {
      "id": "table:sql/cloud/damai_customize.sql:d_rule",
      "type": "table",
      "name": "d_rule",
      "filePath": "sql/cloud/damai_customize.sql",
